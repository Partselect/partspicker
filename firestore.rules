rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function me() { return request.auth.token.email.lower(); }

    // The super admin: the only account that can manage companies, logins, subscriptions and catalogues.
    function isOwner() { return signedIn() && me() == 'bakku3344@gmail.com'; }

    // Each login email points to its company; the company holds the subscription.
    function myLink() { return /databases/$(database)/documents/access/$(me()); }
    function myCompany() { return get(/databases/$(database)/documents/companies/$(get(myLink()).data.company)).data; }
    function hasSub() {
      return signedIn() && exists(myLink())
        && myCompany().active == true
        && request.time < myCompany().end;
    }
    function inPlan(model) { return '*' in myCompany().models || model in myCompany().models; }
    function shown(model) { return get(/databases/$(database)/documents/models/$(model)).data.visible == true; }

    // The super admin can read and change everything (companies, logins, devices, catalogues).
    match /{document=**} {
      allow read, write: if isOwner();
    }

    // Engines: only shown engines in the company's plan, while the company's subscription is running.
    match /models/{model} {
      allow read: if isOwner() || (hasSub() && inPlan(model) && resource.data.visible == true);
      allow write: if isOwner();
    }
    match /models/{model}/figures/{figure} {
      allow read: if isOwner() || (hasSub() && inPlan(model) && shown(model));
      allow write: if isOwner();
    }

    // Companies: a login can read its own company (to see the end date). Max 5 logins per company.
    match /companies/{company} {
      allow read: if isOwner() || (signedIn() && exists(myLink()) && get(myLink()).data.company == company);
      allow create, update: if isOwner() && (!('members' in request.resource.data) || request.resource.data.members.size() <= 5);
      allow delete: if isOwner();
    }

    // First device only: a login registers its first device; only the super admin can reset it.
    match /sessions/{email} {
      allow read: if isOwner() || (signedIn() && me() == email);
      allow write: if isOwner() || (signedIn() && me() == email
        && (resource == null || resource.data.device == 'signed-out' || resource.data.device == request.resource.data.device));
    }

    // Login → company links: a login can read its own; only the super admin changes them (except the password flag).
    match /access/{email} {
      allow read: if isOwner() || (signedIn() && me() == email);
      allow write: if isOwner();
      // after setting their own password, a login may clear its "must change password" flag (and nothing else)
      allow update: if signedIn() && me() == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange'])
        && request.resource.data.mustChange == false;
    }
  }
}
